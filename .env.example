POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=student_activities
# พอร์ตบนเครื่อง ถ้าชนกับ PostgreSQL ที่ลงไว้ในเครื่อง (เช่น ลงบน Windows) ให้เปลี่ยนเป็น 5433
POSTGRES_PORT=5432

# ใช้ตอนรัน backend นอก Docker เท่านั้น (ใน Docker ใช้ DATABASE_URL ที่กำหนดใน compose.yml)
# ค่าจะถูกแทนที่จากตัวแปรด้านบน จึงไม่ต้องแก้บรรทัดนี้
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# โหมดทดสอบแอดมิน: หน้า login ฝั่ง admin ให้เลือกอีเมลแอดมินทดสอบโดยไม่ต้องใส่รหัสผ่าน
# ตอนพัฒนาให้ตั้งเป็น true ถ้าไม่ใช่ true จะเข้าหน้า admin ไม่ได้ (รายชื่อแอดมินอยู่ที่ backend/admin_accounts.py)
# ห้ามเปิดบนเครื่องที่ใช้งานจริง
ADMIN_BYPASS_ENABLED=false

# ใช้ลงลายเซ็น token หลัง login (POST /api/auth/login) ต้องเป็นค่าสุ่มอย่างน้อย 32 ตัวอักษร
# ไม่ตั้ง / สั้นกว่า 32 ตัว = login ไม่ได้ (backend ไม่ออกและไม่รับ token)
# แต่ละเครื่องสร้างค่าของตัวเอง ห้าม commit ค่าจริง:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# แก้แล้วให้ docker compose up -d อีกครั้ง เพื่อให้ backend ได้ค่าใหม่
AUTH_SECRET=
